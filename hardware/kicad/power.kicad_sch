	(text "Logic rails — +5V (driver buck) → +3V3 LDO → +3.3VA (filtered)"
		(exclude_from_sim no)
		(at 21.59 123.19 0)
		(effects
			(font (size 1.778 1.778) (bold yes))
			(justify left top)
		)
		(uuid "a2cb36ca-76cb-57e0-8507-9e9e0d807b7a")
	)
	(rectangle
		(start 190.5 25.4)
