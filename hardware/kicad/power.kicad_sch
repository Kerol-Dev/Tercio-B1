	(text "Test points and mounting"
		(exclude_from_sim no)
		(at 191.77 26.67 0)
		(effects
			(font (size 1.778 1.778) (bold yes))
			(justify left top)
		)
		(uuid "020eac89-2bb7-5e5b-85af-622215faf316")
	)
	(text "V_BUS sense: 100k/5.1k → 20.6:1\n0–60 V → 0–2.91 V (ADC2_IN12)"
		(exclude_from_sim no)
		(at 142.24 99.06 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "ab670c6d-70df-53cf-aa96-be7f738d6b8c")
	)
	(text "+5V comes from the DRV8353R buck (driver sheet), ≤ 250 mA budget.\n+3V3: MCU, MT6835, CAN VIO, aux 3V3 (PTC-limited). +3.3VA: VDDA, VREF+, DRV VREF, NTC pull-ups."
		(exclude_from_sim no)
		(at 25.4 190.5 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "c58903a1-d568-52a8-b69b-20c112729eef")
	)
	(text "Holes isolated from GND (no ground loop through the motor frame)."
		(exclude_from_sim no)
		(at 193.04 96.52 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "946327c1-3d48-58b4-9915-11279bca4501")
	)
	(text "Power-input notes\n• 80 V FETs, 100 V MLCCs, 100 V electrolytic: ≥ 1.5× headroom at 52 V.\n• SMCJ54A (1.5 kW): 54 V standoff, 60 V breakdown — catches hot-plug ringing, not regen.\n  The DRV8353 VM pin (80 V abs max) also sits behind a 10 Ω + 10 µF filter (driver sheet).\n• Regen is limited in firmware (MaxRegenCurrent, OV clamp); bench: e-load in CV mode.\n• Recommend an anti-spark connector (XT90-S) or precharge on the battery side.\n• 22 µF 100 V electrolytic (6.3 × 7.7 mm) damps the supply-cable resonance on hot-plug."
		(exclude_from_sim no)
		(at 190.5 121.92 0)
		(effects
			(font (size 1.524 1.524))
			(justify left top)
		)
		(uuid "186a94d4-8879-571b-a4ce-415291be7c58")
	)
