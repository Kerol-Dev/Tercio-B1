	(text "SPI mode 3, ≤ 16 MHz; burst read returns ANGLE[20:0], STATUS[2:0], CRC8 (x⁸+x²+x+1).\nCAL_EN (pin 4) low→high while spinning at constant speed runs the on-chip self-calibration\n(INL ±0.07° typ.); driven from PC15. TEST and TEST_EN tied to VSS (datasheet Fig. 5/6).\nPlace on the board centre (shaft axis), no copper pours under the sensor, magnet gap per motor."
		(exclude_from_sim no)
		(at 162.56 116.84 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "e4f844f0-a51d-53e1-b2c3-c569ea0a24d2")
	)
