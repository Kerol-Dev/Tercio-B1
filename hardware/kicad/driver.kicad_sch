	(text "+5V buck — integrated LM5008A (COT, 350 mA), ≈ 180 kHz"
		(exclude_from_sim no)
		(at 21.59 97.79 0)
		(effects
			(font (size 1.778 1.778) (bold yes))
			(justify left top)
		)
		(uuid "3cda2296-5d50-5279-9571-e322d20fa21d")
	)
	(rectangle
		(start 20.32 190.5)
		(end 205.74 254)
		(stroke
			(width 0.254)
			(type dash)
			(color 132 132 132 1)
		)
		(fill (type none))
		(uuid "6edbb73b-7d25-5819-bb37-34fea526be00")
	)
	(text "Logic interface — pulls keep the driver safe while the MCU is in reset"
		(exclude_from_sim no)
		(at 21.59 191.77 0)
		(effects
			(font (size 1.778 1.778) (bold yes))
			(justify left top)
		)
		(uuid "c6d3f577-916e-5cff-8759-8e5bd5912419")
	)
	(rectangle
		(start 279.4 190.5)
