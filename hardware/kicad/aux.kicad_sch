	)
	(text "GH-8 pinout and modes\n1  3V3 out (PTC 50 mA)\n2  AUX1  PA15  SPI3_NSS · I2C1_SCL · TIM2_CH1 (A / STEP) · USART2_RX\n3  AUX2  PB3   SPI3_SCK · TIM2_CH2 (B / DIR) · USART2_TX\n4  AUX3  PB4   SPI3_MISO · TIM3_CH1 (RC PWM in) · ENABLE\n5  AUX4  PB5   SPI3_MOSI · TIM3_CH2\n6  AUX5  PB7   I2C1_SDA · Z index (EXTI)\n7  ANA   PA2   motor NTC (10k pull-up via JP701) or 0–3.3 V analog\n8  GND"
		(exclude_from_sim no)
		(at 35.56 50.8 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "0a278eaf-870f-5199-a10e-cd674a74aeae")
	)
