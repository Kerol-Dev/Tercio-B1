	(text "VSS 35/47 are stacked\nwith VSS 23 in the symbol."
		(exclude_from_sim no)
		(at 238.76 195.58 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "7f74c394-a0ce-538d-b791-b7b4027dfb7b")
	)
	(text "C_L = 9 pF → 2 × (9 − ~3 pF stray)\n= 12 pF C0G. HSE checked against\nHSI at boot (board/Clock.cpp)."
		(exclude_from_sim no)
		(at 96.52 40.64 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "58d2de63-907c-53d0-89fd-dfb16e028196")
	)
	(text "PB8-BOOT0: 10k to GND, never a\nsignal pin. Option bytes keep\nnBOOT0 = 1, nSWBOOT0 = 0."
		(exclude_from_sim no)
		(at 83.82 152.4 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "401c2a4b-1d36-53bb-ba9f-9e2f00f5efc2")
	)
	(text "Green from +5V: V_F ≈ 2.9 V needs\nmore than 3.3 V headroom; off-state\nleaves the pin ≤ 3.3 V."
		(exclude_from_sim no)
		(at 83.82 208.28 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "c815c94d-1680-5963-8677-064244833440")
	)
	(text "100 Ω + 1 nF: τ = 100 ns ≪ CSA settling (0.25–2 µs);\nisolates the CSA output from the ADC sample cap."
		(exclude_from_sim no)
		(at 309.88 111.76 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "9f4d000d-0536-5ed4-a68b-f41862ef7a38")
	)
